+    @EventHandler(priority = EventPriority.LOWEST)
+    public void onEntityTrampleSoil(EntityChangeBlockEvent event) {
+        if (!(event.getEntity() instanceof Player player)) {
+            return;
+        }
+
+        if (event.getBlock().getType() != Material.FARMLAND) {
+            return;
